# Copy this file to .env and fill in real values. NEVER commit the real .env.
# On Railway, set these as Variables in the service settings instead of a file.

# --- Anthropic (the brain) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Pick the current Sonnet-class model string. Bump this when a newer one ships.
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Wix Bookings (real-time availability) ---
# IST-prefixed API key from the Wix API keys manager.
WIX_API_KEY=IST.xxxxxxxxxxxxxxxxxxxx
WIX_SITE_ID=b36dc4a6-8b3b-425b-864d-4f0ef7af61b9

# --- Server ---
PORT=8787
# Comma-separated list of origins allowed to call /chat (your Wix domain).
ALLOWED_ORIGINS=https://www.vstennisacademy.com,https://vstennisacademy.com

# --- Wix form -> GHL webhook (POST /wix-lead) ---
# Shared secret. Wix must send it as the x-wix-secret header or a ?secret= query
# param. If this is unset the endpoint rejects everything (fail closed).
WIX_WEBHOOK_SECRET=

# --- Owner notifications (escalations) ---
# TODO: fill in once the notification channel is decided (e.g. a webhook or GHL).
OWNER_NOTIFY_WEBHOOK=
